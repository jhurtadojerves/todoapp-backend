FROM python:3.13.3-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings_prod

WORKDIR /app

# Install Python dependencies first so this layer is cached between code changes
COPY requirements.txt requirements_prod.txt ./
RUN pip install --no-cache-dir -U pip && pip install --no-cache-dir -r requirements_prod.txt

COPY . .

# Non-root user; staticfiles/ is pre-created so the named volume inherits its ownership
RUN useradd --create-home --uid 1000 app && \
    mkdir -p /app/staticfiles && \
    chown -R app:app /app
USER app

EXPOSE 8000

# collectstatic runs at start (not build) so the shared volume nginx reads is refreshed on every deploy
CMD ["sh", "-c", "python manage.py collectstatic --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --access-logfile - --error-logfile -"]
